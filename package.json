{
  "name": "olympic-games-starter",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --stats-json",
    "build:analyze": "ng build --configuration production,analysis --stats-json",
    "preview": "pnpm dlx serve -s --config serve.json",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "docs": "compodoc -p tsconfig.doc.json -d documentation --language fr-FR -n \"TéléSport — Documentation Angular\"",
    "docs:serve": "pnpm run docs --serve --host 127.0.0.1 --port 8080",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json && tsc --noEmit -p tsconfig.e2e.json",
    "build:e2e": "pnpm run build --configuration production --base-href /p2-angular-maintainable-frontend/",
    "test:e2e": "playwright test"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/platform-browser-dynamic": "^21.2.25",
    "@angular/router": "^21.2.25",
    "chart.js": "^4.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "21.4.0",
    "@angular-eslint/schematics": "21.4.0",
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.25",
    "@compodoc/compodoc": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^24.19.1",
    "angular-eslint": "21.4.0",
    "eslint": "^10.3.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.59.2"
  },
  "packageManager": "pnpm@12.10.1"
}
