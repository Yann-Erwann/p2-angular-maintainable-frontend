{
  "eslint.run": "onType",

  "eslint.validate": [
    "typescript",
    "html"
  ],

  "eslint.workingDirectories": [
    {
      "mode": "location"
    }
  ],

  "eslint.quiet": false,

  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },

  "editor.detectIndentation": false,
  "editor.insertSpaces": true,
  "editor.tabSize": 2,
  "editor.renderWhitespace": "boundary"
}