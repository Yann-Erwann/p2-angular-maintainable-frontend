{
  "public": "dist/olympic-games-starter/browser",
  "cleanUrls": false,
  "directoryListing": false,
  "headers": [
    {
      "source": "**",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "@(main|polyfills|styles|chunk)-????????.@(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
